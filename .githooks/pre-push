#!/usr/bin/env sh
set -eu

main_branch="refs/heads/main"
dev_branch="refs/heads/dev"
zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$main_branch" ]; then
    echo "Blocked: direct pushes to main are not allowed." >&2
    echo "Push your work to dev, then open a pull request into main." >&2
    exit 1
  fi

  [ "$remote_ref" = "$dev_branch" ] || continue

  if [ "$local_sha" = "$zero_sha" ]; then
    echo "Blocked: deleting dev is not allowed." >&2
    exit 1
  fi

  if [ "$remote_sha" != "$zero_sha" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "Blocked: non-fast-forward pushes to dev are not allowed." >&2
    echo "Pull/rebase origin/dev first, then push normally." >&2
    exit 1
  fi
done

exit 0
